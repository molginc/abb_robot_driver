#-------------------------------------------------------------------------------
# Description:
#   The purpose of this service definition, is to define a way to get all
#   'External Motion Interface Data' instances (EGM configurations) defined in
#   an ABB robot controller system.
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# Service request fields
#-------------------------------------------------------------------------------

---

#-------------------------------------------------------------------------------
# Service response fields
#-------------------------------------------------------------------------------
# External Motion Interface Data instances.
ExtMotionData[] instances

# Service success/failure indicator.
# Refer to 'abb_robot_msgs/ServiceResponses' for defined error codes.
uint16 result_code

# Status message (empty if service succeeded).
string message
